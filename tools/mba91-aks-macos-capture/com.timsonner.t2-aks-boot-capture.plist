<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.timsonner.t2-aks-boot-capture</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/t2-aks-boot-capture.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/log/t2-aks-capture/daemon.out</string>
	<key>StandardErrorPath</key>
	<string>/var/log/t2-aks-capture/daemon.err</string>
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
